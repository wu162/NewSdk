<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>BinaryAssetBuilder.AudioCompiler</AssemblyName>
    <RootNamespace>BinaryAssetBuilder.AudioCompiler</RootNamespace>
    <TargetFramework>net472</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>10.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BinaryAssetBuilder.Core">
      <HintPath>../../../../SDK/tools/BinaryAssetBuilder.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <EaLayer3Native Include="../../Native/Audio/**/*.cpp;../../Native/Audio/**/*.h" />
  </ItemGroup>
  <Target Name="BuildEaLayer3" BeforeTargets="Build" Condition="'$(OS)' == 'Windows_NT'"
          Inputs="@(EaLayer3Native);../../../scripts/BuildEaLayer3.ps1" Outputs="$(TargetDir)NewSdk.EaLayer3.dll">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../../scripts/BuildEaLayer3.ps1&quot; -OutputDirectory &quot;$(TargetDir)&quot; -Configuration $(Configuration)" />
  </Target>
</Project>

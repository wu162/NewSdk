<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="assetbuilder" type="BinaryAssetBuilder.SerializedSectionHandler,BinaryAssetBuilder.Core" />
    <section name="SqlMetricsListener" type="System.Configuration.NameValueFileSectionHandler" />
    <section name="BABFileMetricsListener" type="System.Configuration.NameValueFileSectionHandler" />
  </configSections>
  <!-- monitorPaths is for persistent BAB, in addition to root/art/audio/data, folders that should be monitored for changes -->
  <assetbuilder serializedType="BinaryAssetBuilder.Settings,BinaryAssetBuilder.Core" schema="..\Schemas\xsd\CnC3Types.xsd" dataRoot=".." defaultArtPaths=".\Art" defaultAudioPaths=".\Audio" defaultDataPaths=".;.\Mods;.\SAGEXML" monitorPaths="..\">
    <monitorPaths>
      <path value="t" />
    </monitorPaths>
    <plugins>
      <!-- special handling for texture types -->
      <plugin assetTypes="TerrainTextureAtlas,Texture,OnDemandTexture" enabled="true" useBuildCache="false" targetType="BinaryAssetBuilder.TextureCompiler.Plugin, BinaryAssetBuilder.TextureCompiler" />
      <!-- special handling for audio -->
      <plugin assetTypes="AudioFile,AudioFileMP3Passthrough,PathMusicMap,PathMusicTrack,PathMusicEvent" enabled="true" useBuildCache="false" targetType="BinaryAssetBuilder.AudioCompiler.Plugin, BinaryAssetBuilder.AudioCompiler" />
      <!-- special handling for animation -->
      <plugin assetTypes="W3DAnimation,W3DMesh" enabled="true" useBuildCache="false" targetType="BinaryAssetBuilder.W3XCompiler.Plugin, BinaryAssetBuilder.W3XCompiler" />
      <!-- this is the default handler for all types - no need to explicitly add new types anymore -->
      <plugin assetTypes="#all" enabled="true" targetType="BinaryAssetBuilder.XmlCompiler.Plugin, BinaryAssetBuilder.XmlCompiler" useBuildCache="false" />
      <plugin assetTypes="AttributeModifier,FXList,SpecialPowerTemplate,ObjectCreationList,LocomotorTemplate,LogicCommandSet,FXParticleSystemTemplate,UpgradeTemplate,AIPersonalityDefinition,AIStrategicStateDefinition,AIMicroManagerData,AIBudgetStateDefinition,AIStateDefinition,AITargetingHeuristic,LogicCommand,PlayerTech,PlayerTechRank,PlayerTechUpgradeBinding,ExperienceLevelTemplate,PlayerTechStoreTemplate,PurchasePlayerTechButtonTemplate,ButtonSingleStateData,UICommandButton,FontDefaultSetting,FontTranslation,FontSubstitution,Weather,WaterTransparency,WaterSetting,Environment,LightingSettings,WaterTextureList,TerrainParticleMapping,BounceKickTerrainMapping,ShadowMap,OrdersManagerSettings,TerrainVisualSettings,CameraSettings,AIData,UnitAISettings,PlayerTemplate,MultiplayerSettings,AIBuildStateDefinition,AIStrategicStateName,MultiplayerColor,AIPersonalityToAchievementEventMapping,FormationAssistantUnitDefinition,FormationAssistantTemplate,FormationSelectionTemplate,FormationAssistant,GameStatsModeData,SkirmishSettings,DamageFX,DamageFXSettings,GeneralHotKeySlots,DefaultHotKeys,DebugHotKeys,MappableKey,AudioEventLimitGroup,AudioLOD,AudioSettings,Video,VideoEventList,MicrophoneSettings,BootupDisplaySequence,HotKeySlot,MouseCursor,BasicMouseCursors,UIMouseDragSelectionFeedback,UIFloatingTextDisplay,UIMessageDisplay,UIMilitaryCaptionDisplay,UISubtitleDisplay,UITimerDisplay,DynamicGameLOD,GameLODPreset,StaticGameLOD,UICoopTinting,RadiusCursor,AnimationSoundSettings,MiscAudio,LargeGroupAudioMap,UIMouseTacticalSelectionDetailsButtonHotKeys,UIMouseTacticalMainCommandBarHotKeys,UIMouseTacticalPlayerPowerHotKeys,UIMouseTacticalMiscHotKeys,UIMouseHUDElementHotKeyGate,UIQuickChatMessage,UIMouseTacticalQuickChatDisplay,UIMouseVoiceChat,UIDecalGrid,UIDecalCloud,UIDecalDestinationMarker,UIWorldBuilderDecalGrid,BaseAudioEventInfo,BaseSingleSound,AudioEvent,MusicTrack,MP3MusicTrack,DialogEvent,MP3DialogEvent,AmbientStream,MP3AmbientStream,Multisound,PathMusicGameDynamicState,PathMusicGameDynamicStateSet,PathMusicGameDynamicTransition,PathMusicEventRuntime,PathMusicEventSet,PathMusicMapRuntime,MusicPalette,MusicScriptConditionNuggetBase,MusicScriptConditionExpensiveNuggetBase,MusicScriptConditionNugget_LocalPlayerIsObserver,MusicScriptConditionNugget_UnitsFarFromBase,MusicScriptConditionNugget_TimeFromStartOfLevel,MusicScriptConditionNugget_TrackPlayedCount,MusicScriptConditionNugget_SpecificTrackTypePlaying,MusicScriptConditionNugget_AnyTrackPlaying,MusicScriptConditionNugget_ObjectsOfTypeExist,MusicScriptConditionNugget_EvaEventPlayedRecently,MusicScriptConditionNugget_ObjectsNearEvaEvent,MusicScriptConditionNugget_ScoredKillCount,MusicScriptConditionNugget_Not,MusicScriptConditionNugget_Or,MusicScriptConditionNugget_And,MusicScriptConditionNugget_PathMusicStateLastActive,MusicScriptConditionNugget_PathMusicStateCurrentlyActive,MusicScriptConditionNugget_EngagementCount,MusicScriptConditionNugget_LocalPlayerKillRatio,MusicScriptConditionNugget_HitBySuperWeapon,MusicScriptTrack,UIMouseTacticalCoOpAIButtonsHelpButton,UIMouseTacticalCommandCommunicateWithAllies,UIMouseTacticalToggleRepairModeButton,UIMouseTacticalAttackMoveButton,UIMouseTacticalCommandPlaceWall,UIMouseTacticalForceAttackMoveButton,UIMouseTacticalCoOpAIButtonsHoldObjectButton,UIMouseTacticalExitContainerButton,UIMouseTacticalPlayerTechStoreButton,UIMouseTacticalCommandMove,UIMouseTacticalCommandSell,UIMouseTacticalUnitIntroButton,UIMouseTacticalCommandSelect,UIMouseTacticalCoOpAIButtonsNormalButton,UIMouseTacticalCommandPlaceRallyPoint,UIMouseTacticalCommandHarvest,UIMouseTacticalCommandToggleSelfRepair,UIMouseTacticalBuildQueueTab,UIMouseTacticalCommandGetCrate,UIMouseTacticalDeactivateMissionHotSpotsButton,UIMouseTacticalCommandForceAttack,UIMouseTacticalPlanningModeButton,UIMouseTacticalCommandMisc,UIMouseTacticalSelectionRefinementTab,UIMouseTacticalCommandForceMove,UIMouseTacticalOpenAdvancedCommandsButton,UIMouseTacticalSetStanceButton,UIMouseTacticalCoOpAIButtonsHoldPositionButton,UIMouseTacticalCommandMineOre,UIMouseTacticalWaypointModeButton,UIMouseTacticalReverseMoveButton,UIMouseTacticalCommandEnter,UIMouseTacticalCoOpAIButtonsAssaultButton,UIMouseTacticalPauseButton,UIMouseTacticalCommandAttack,UIMouseTacticalCommandAttackMove,UIMouseTacticalForceMoveButton,UIMouseTacticalForceAttackButton,UIMouseTacticalCommandPlaceAIBeacon,UIMouseTacticalCommandDock,UIMouseTacticalCommandReverseMove,UIMouseTacticalBuildQueueTypeTab,UIMouseTacticalSellModeButton,UIMouseTacticalStopButton,UIMouseTacticalCommandSetRallyPoint,UIMouseTacticalFastForwardButton,UIMouseTacticalGroupSelection,UIMouseTacticalLookAt,UIMouseTacticalRadarTelestrator,UIMouseTacticalTelestrator,UIMouseTacticalThreatMeter,BaseConditionData,ObjectConditionData,UpgradeConditionData,GameplayConditionData,TargetingBaseCompare,TargetingDistanceCompare,TargetingCombatChainCompare,TargetingInTurretArcCompare,TargetingCompareList,SiegeEvaEvent,EvaSettings,EvaEvent,MiscEvaEvents,AchievementEvent,MapNameToAchievementEventMapping,GameplayAchievementTriggerData,HealthBarTemplate,HealthBarSettings,UnitOverlayIconSettings,ObjectFilterAsset,RegisteredObjectSet,ObjectVisionRangeItem,InvisibilityTemplate,InvisibilityManagerSettings,StanceTemplate,EmotionTemplate,ProjectilePath,ForceFeedbackEvent,EngagingContent,EngagingContentGroup,EngagingContentSequence,IntelDB,UnitIntro,BreezeInfo,ModelSettings,AutoParticleSystemSettings,CrowdResponse,RadarTerrainImage,UIRadarObjectsLayer,W3DDeviceSettings,ScorchMarkSettings,Language,HeaderTemplate,FontDirectory,TheVersion,Credits,CommandSet,Road,ShaderOverride,ShaderOverrideRule,ImageSequence,UnitTypeIcon,DrawGroupInfo,OnlineChatColors,ArchivableMovie,ArchiveMovieList,NetworkSettings,PathfindSettings,ResourceSettings,GraphicsHardware,CampaignTemplate,CampaignEnumerator,MissionTemplate,MissionHotSpotSettings,TutorialMapData,LocalBuildListMonitor,BuildSystemSettings,GiftManagerSettings,MpGameRules,DynamicsContactTagMapping,ConnectionLineManager,RedAlertTemplate,ConquerCardDefinitionBase,ConquerCardDefinitionUnit,ConquerCardDefinitionStructure,ConquerCardDefinitionPower,ConquerCardPrebuiltDeck,ArmyDefinition,SkirmishOpeningMove,DLContent,AssetReportTable,StringHashTable,MeshInstanceTemplate,PackedTextureImage,OnDemandTextureImage,AptAptData,AptConstData,AptDatData,AptGeometryData,BaseRenderAssetType,AudioFileRuntime,Mouse,UnitAbilityButtonTemplate,PlayerPowerButtonTemplate,TestTexture,TestTextureCollection,TerrainAssetCollection,TerrainTextureAtlasRuntime,W3DHierarchy,W3DContainer,W3DAnimationRuntime,W3DCollisionBox,MapMetaData,GameScriptList,GameMap,UIConfigList" enabled="true" useBuildCache="false" targetType="BinaryAssetBuilder.XmlCompiler.Plugin, BinaryAssetBuilder.XmlCompiler" />
      <plugin assetTypes="GameObject" targetType="BinaryAssetBuilder.Tokenizer.Plugin, BinaryAssetBuilder.Tokenizer" enabled="true" useBuildCache="false" />
      <plugin assetTypes="WeaponTemplate" targetType="BinaryAssetBuilder.Tokenizer.Plugin, BinaryAssetBuilder.Tokenizer" enabled="true" useBuildCache="false" />
      <plugin assetTypes="ArmorTemplate" targetType="BinaryAssetBuilder.Tokenizer.Plugin, BinaryAssetBuilder.Tokenizer" enabled="true" useBuildCache="false" />
    </plugins>
    <verifiers>
      <!-- this is the default handler for all types - no need to explicitly add new types anymore -->
      <plugin assetTypes="#all" enabled="true" targetType="BinaryAssetBuilder.GameDataVerifier.Plugin, BinaryAssetBuilder.GameDataVerifier" />
    </verifiers>
    <StringHashBins>
      <!-- The InstanceId and TypeId are internally handled by BAB -->
      <Type SchemaType="Poid" Bin="POID" />
      <Type SchemaType="StringHash" Bin="STRINGHASH" />
    </StringHashBins>
    <buildConfigurations>
      <!-- Shipping configurations -->
      <buildConfiguration name="LowLOD" postfix="L" />
      <buildConfiguration name="MediumLOD" postfix="M" />
    </buildConfigurations>
  </assetbuilder>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
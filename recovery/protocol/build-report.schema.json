{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newsdk.local/protocol/1.0/build-report.schema.json",
  "title": "NewModCompiler BuildReport 1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "buildId",
    "status",
    "exitCode",
    "requestArguments",
    "effectiveOptions",
    "selectedContent",
    "plan",
    "stages",
    "diagnostics",
    "diagnosticCounts",
    "loadedProviders",
    "externalTools",
    "cache",
    "elapsedMs",
    "artifacts",
    "logPaths",
    "executionMode",
    "publicationStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "buildId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "exitCode": {
      "enum": [
        0,
        2,
        3,
        4,
        5,
        6,
        7
      ]
    },
    "requestArguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effectiveOptions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "Value",
          "Source"
        ],
        "properties": {
          "Value": {
            "type": "string"
          },
          "Source": {
            "enum": [
              "default",
              "project",
              "commandLine"
            ]
          }
        }
      }
    },
    "selectedContent": {
      "type": "array",
      "items": {
        "enum": [
          "base",
          "apt",
          "maps"
        ]
      }
    },
    "plan": {
      "type": [
        "object",
        "null"
      ]
    },
    "stages": {
      "type": "array"
    },
    "diagnostics": {
      "type": "array"
    },
    "diagnosticCounts": {
      "type": "object"
    },
    "loadedProviders": {
      "type": "array"
    },
    "externalTools": {
      "type": "array",
      "maxItems": 0
    },
    "cache": {
      "type": "object",
      "properties": {
        "executionEngine": {
          "enum": ["AssetTasks.v1", "LegacySession"]
        },
        "cacheMode": {
          "enum": ["ActionCache", "Disabled", "SessionPackage"]
        },
        "requestedJobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "resourcePolicy": { "enum": ["MachineResources.v1", "LegacySession"] },
        "logicalProcessorCount": { "type": "integer", "minimum": 0 },
        "effectiveJobs": { "type": "integer", "minimum": 0, "maximum": 32 },
        "minimumEffectiveJobs": { "type": "integer", "minimum": 0, "maximum": 32 },
        "taskMemoryBudgetBytes": { "type": "integer", "minimum": 0 },
        "minimumTaskMemoryBudgetBytes": { "type": "integer", "minimum": 0 },
        "perTaskMemoryLimitBytes": { "type": "integer", "minimum": 0 },
        "resourceMemoryQuerySucceeded": { "type": "boolean" },
        "backendCalls": {
          "type": "integer",
          "minimum": 0
        },
        "maxBackendConcurrency": {
          "type": "integer",
          "minimum": 0
        },
        "actionHits": {
          "type": "integer",
          "minimum": 0
        },
        "actionMisses": {
          "type": "integer",
          "minimum": 0
        },
        "hashReadBytes": {
          "type": "integer",
          "minimum": 0
        },
        "inputIdentityQueries": { "type": "integer", "minimum": 0 },
        "inputIdentitySkippedFiles": { "type": "integer", "minimum": 0 },
        "inputInventoryCaptures": { "type": "integer", "minimum": 0 },
        "inputHashReusedBytes": { "type": "integer", "minimum": 0 },
        "inputHashLeaseFiles": { "type": "integer", "minimum": 0, "maximum": 512 },
        "actionMissReasons": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "cacheBypassReasons": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "preparationRejectedReasons": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "cacheCopyBytes": {
          "type": "integer",
          "minimum": 0
        },
        "peakSampledPrivateBytes": {
          "type": "integer",
          "minimum": 0
        },
        "backendCallsByType": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "backendIntervals": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": ["typeName", "sourcePath", "startTicks", "endTicks", "threadId"],
            "properties": {
              "typeName": {"type": "string", "minLength": 1},
              "sourcePath": {"type": "string", "minLength": 1},
              "startTicks": {"type": "integer", "minimum": 0},
              "endTicks": {"type": "integer", "minimum": 0},
              "threadId": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "elapsedMs": {
      "type": "integer",
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "Path",
          "Kind",
          "Size",
          "Sha256"
        ],
        "properties": {
          "Path": {
            "type": "string"
          },
          "Kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "Size": {
            "type": "integer",
            "minimum": 0
          },
          "Sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "logPaths": {
      "type": "object",
      "required": [
        "events",
        "report",
        "text"
      ]
    },
    "executionMode": {
      "enum": [
        "PlanOnly",
        "InProcess"
      ]
    },
    "publicationStatus": {
      "enum": [
        "NoCompilationRequested",
        "IsolatedStagingOnly",
        "PublishedDirectory",
        "NotPublished",
        "RolledBack",
        "RollbackFailed"
      ]
    },
    "publicationDirectory": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputRoots": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "dataRoot",
        "schemaPath",
        "dataPaths",
        "artPaths",
        "audioPaths",
        "sources"
      ],
      "properties": {
        "dataRoot": {
          "type": "string"
        },
        "schemaPath": {
          "type": "string"
        },
        "dataPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audioPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "object",
          "required": [
            "dataRoot",
            "dataPaths",
            "artPaths",
            "audioPaths"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}

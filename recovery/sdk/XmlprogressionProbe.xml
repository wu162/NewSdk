       least one Binding, so one already recovered UpgradeTemplate support
       asset is included. All references are local; no raw TypeId/reference
       index or external resource is injected by these source fixtures. -->
  <LogicCommand id="RecoveryXmlAdditional_LogicCommand_Defaults" />
  <PlayerTech id="RecoveryXmlAdditional_PlayerTech_Defaults" />
  <PlayerTechRank id="RecoveryXmlAdditional_PlayerTechRank_Defaults" />
  <UpgradeTemplate id="RecoveryXmlAdditional_UpgradeTemplate_Support" />
  <PlayerTechUpgradeBinding id="RecoveryXmlAdditional_PlayerTechUpgradeBinding_Defaults">
    <Binding TechDependency="RecoveryXmlAdditional_PlayerTech_Defaults"
        UpgradeToGrant="RecoveryXmlAdditional_UpgradeTemplate_Support" />
  </PlayerTechUpgradeBinding>
  <ExperienceLevelTemplate id="RecoveryXmlAdditional_ExperienceLevelTemplate_Defaults">
    <LevelUpTintColor />
  </ExperienceLevelTemplate>
</AssetDeclaration>

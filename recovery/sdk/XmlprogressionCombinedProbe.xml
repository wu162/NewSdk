      <Component Style="ADDITIVE_DECAL" OpacityMin="50%" OpacityMax="100%"
          MinRadius="8.5" MaxRadius="9.75"><Color R="85" G="102" B="119" A="136" /></Component>
    </Decal>
  </ExperienceLevelTemplate>
  <ExperienceLevelTemplate id="RecoveryXmlAdditional_ExperienceLevelTemplate_Inherited"
      inheritFrom="RecoveryXmlAdditional_ExperienceLevelTemplate_Combined" Rank="4" ExperienceAward="29">
    <LevelUpTintColor r="0.875" />
  </ExperienceLevelTemplate>
  <ButtonSingleStateData id="RecoveryXmlAdditional_ButtonSingleStateData_Combined">
    <State Title="Recovery title" Description="Recovery description" TypeDescription="Recovery type" />
  </ButtonSingleStateData>
  <PurchasePlayerTechButtonTemplate id="RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Combined"
      PlayerTech="RecoveryXmlAdditional_PlayerTech_Combined"
      StateData="RecoveryXmlAdditional_ButtonSingleStateData_Combined" />
  <PlayerTechStoreTemplate id="RecoveryXmlAdditional_PlayerTechStoreTemplate_Combined" Faction="Soviet">
    <Row><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Combined</Button><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Defaults</Button><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Combined</Button></Row>
    <Row><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Defaults</Button><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Combined</Button><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Defaults</Button></Row>
    <Row><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Combined</Button><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Combined</Button><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Defaults</Button></Row>
    <Row><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Defaults</Button><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Defaults</Button><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Combined</Button></Row>
    <Row><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Combined</Button><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Defaults</Button><Button>RecoveryXmlAdditional_PurchasePlayerTechButtonTemplate_Defaults</Button></Row>
  </PlayerTechStoreTemplate>
  <UICommandButton id="RecoveryXmlAdditional_UICommandButton_Combined">
    <FactionSettings Faction="Allies"><ImageTintColor R="17" G="34" B="51" /></FactionSettings>
    <FactionSettings Faction="Soviet"><ImageTintColor R="68" G="85" B="102" /></FactionSettings>
    <FactionSettings Faction="Japan"><ImageTintColor R="119" G="136" B="153" /></FactionSettings>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Upstream Condition="'$(Upstream)' == ''">$(MSBuildThisFileDirectory)../.work/upstream</Upstream>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="SharpCompress" Version="0.26.0" />
    <Compile Include="$(Upstream)/SwfLib/**/*.cs" Exclude="$(Upstream)/SwfLib/obj/**;$(Upstream)/SwfLib/bin/**" />
    <Compile Include="$(Upstream)/eaf2apt/**/*.cs" Exclude="$(Upstream)/eaf2apt/Program.cs;$(Upstream)/eaf2apt/obj/**;$(Upstream)/eaf2apt/bin/**" />
    <Compile Include="../.work/MemoryAptConverter.cs" />
    <Compile Include="../MemoryAssets.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>

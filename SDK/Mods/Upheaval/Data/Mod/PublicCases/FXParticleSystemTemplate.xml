        <Lifetime High="6" Low="5"/>
        <Size High="35" Low="20"/>
        <BurstCount High="10" Low="8"/>
        <Alphas>
            <Alpha Frame="1" High="0.4" Low="0.3" RelativeAge="0"/>
            <Alpha Frame="2" High="0.4" Low="0.3" RelativeAge="40"/>

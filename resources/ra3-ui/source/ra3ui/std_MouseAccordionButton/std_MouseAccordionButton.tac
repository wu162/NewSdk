  &defineMovieClip 58 // total frames: 25

    &frame 0
      &stop
    &end // of frame 0

    &frame 5
      &stop
    &end // of frame 5

    &frame 6
      &gotoFrame 7
      &play
    &end // of frame 6

    &frame 10
      &stop
    &end // of frame 10

    &frame 15
      &stop
    &end // of frame 15

    &frame 19
      &stop
    &end // of frame 19

    &frame 20
      &pushs ' ------------------------ fucking AAAAAAAAAAAAAAAAAAAAAAAAA'
      &trace
    &end // of frame 20

    &frame 24
      &pushzero
      &pushthis
      &getVariable
      &pushs '_parent'
      &getMember
      &pushs 'outtroComplete'
      &callmp
      &stop
    &end // of frame 24
  &end // of defineMovieClip 58
  
